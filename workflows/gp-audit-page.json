      "name": "ExtractSeoFields"
    },
    {
      "parameters": {
        "jsCode": "// Runs once for each page: clean the text and count what the rules will need\nconst page = $json;\nconst source = $('FromOrchestrator').first().json;\n\nconst cleanText = (page.body_text || '')\n  .replace(/\\[(https?:|data:)[^\\]]*\\]/g, ' ')  // remove [link] and [image] placeholders\n  .replace(/\\s+/g, ' ')                         // collapse repeated spaces and line breaks\n  .trim();\n\nconst alts = page.img_alts || [];\n\nreturn { json: {\n  url: source.url,\n  page_type: source.page_type,\n  title: page.title || '',\n  meta_description: page.meta_description || '',\n  canonical: page.canonical || '',\n  lang: page.lang || '',\n  h1: page.h1 || [],\n  h1_count: (page.h1 || []).length,\n  h2_count: (page.h2 || []).length,\n  json_ld_count: (page.json_ld || []).length,\n  img_total: alts.length,\n  img_missing_alt: alts.filter(alt => !alt || !alt.trim()).length,\n  word_count: cleanText ? cleanText.split(' ').length : 0,\n  content_text: cleanText.slice(0, 6000)\n}};"
      },
      "type": "n8n-nodes-base.code",
