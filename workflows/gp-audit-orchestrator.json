    {
      "parameters": {
        "jsCode": "// Builds one summary email from the whole run\nconst config = $('SetAuditConfig').first().json;\nconst backlog = $('Prioritize').all().map(item => item.json);\nconst pagesPlanned = $('CollectUrls').all().length;\nconst audited = $('AuditPage').all().map(item => item.json);\nconst pagesAudited = audited.length;\nconst pagesFailed = pagesPlanned - pagesAudited;\n\n// Health checks: warn when the run itself looks unreliable\nconst warnings = [];\nconst failRate = pagesPlanned ? pagesFailed / pagesPlanned : 0;\nif (failRate > 0.3) warnings.push(`${pagesFailed} of ${pagesPlanned} pages could not be loaded (more than 30%). See the \"Failed\" tab.`);\nconst noScore = audited.filter(p => p.geo_score === null || p.geo_score === undefined).length;\nif (pagesAudited && noScore / pagesAudited > 0.3) warnings.push(`${noScore} of ${pagesAudited} pages got no valid Claude score (more than 30%).`);\nconst toReview = backlog.filter(r => r.needs_review).length;\nif (toReview > 0) warnings.push(`${toReview} findings have a Claude quote that was not found on the page. Check them by hand.`);\n\n// Top 5 Quick Wins. If a finding has a pattern row, show only that row here;\n// its page rows stay in the sheet for the content writer.\nconst patternFindings = new Set(backlog.filter(r => r.scope === 'pattern').map(r => r.finding));\nconst quickWins = backlog\n  .filter(r => r.quadrant === 'Quick Win')\n  .filter(r => !(r.scope === 'page' && patternFindings.has(r.finding)))\n  .slice(0, 5);\nconst count = q => backlog.filter(r => r.quadrant === q).length;\n\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst short = s => { const t = String(s ?? ''); return t.length > 160 ? t.slice(0, 157) + '...' : t; };\n\nconst winsHtml = quickWins.length\n  ? '<ol>' + quickWins.map(r =>\n      `<li><b>${esc(r.finding)}</b> (${esc(r.scope)}, ${r.pages_affected} page${r.pages_affected === 1 ? '' : 's'}, owner: ${esc(r.owner)})<br>` +\n      `${esc(short(r.detail))}<br><small>${esc(r.example_url)}</small></li>`).join('') + '</ol>'\n  : '<p>No Quick Wins in this run.</p>';\n\nconst healthHtml = warnings.length\n  ? '<ul>' + warnings.map(w => `<li>⚠️ ${esc(w)}</li>`).join('') + '</ul>'\n  : '<p>✅ No problems with this run.</p>';\n\nconst html = `\n<h2>GotPhoto SEO/GEO audit</h2>\n<p><b>Pages:</b> ${pagesAudited} audited, ${pagesFailed} failed (of ${pagesPlanned} planned)<br>\n<b>Findings:</b> ${backlog.length} total: ${count('Quick Win')} Quick Win, ${count('Big Bet')} Big Bet, ${count('Fill-in')} Fill-in, ${count('Deprioritize')} Deprioritize</p>\n<h3>Run health</h3>${healthHtml}\n<h3>Top Quick Wins</h3>${winsHtml}\n<p><a href=\"${esc(config.sheet_url || '')}\">Open the full backlog</a></p>\n<p><small>Findings are suggestions for the marketing team to review, not final to-dos.</small></p>`;\n\nconst subject = `${warnings.length ? '⚠️ ' : ''}GotPhoto audit: ${backlog.length} findings, ${count('Quick Win')} Quick Wins (${pagesAudited} page${pagesAudited === 1 ? \"\" : \"s\"})`;\n\nreturn [{ json: { subject, html, pages_planned: pagesPlanned, pages_audited: pagesAudited, pages_failed: pagesFailed, warnings: warnings.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1632,
